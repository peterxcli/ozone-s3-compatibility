{
  "name": "ozone-s3-compatibility-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:case-search": "bash ../scripts/build_case_search.sh",
    "build:parquet-viewer": "bash ../scripts/build_parquet_viewer.sh",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:all": "npm run build:parquet-viewer && npm run build:case-search && npm run build",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "chart.js": "^4.5.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0"
  }
}
